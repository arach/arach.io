---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import CalBooking from "@components/CalBooking";
import DitheredPortrait from "@components/DitheredPortrait";
import { resumeData } from "@data/resume";
import { projects, accounts } from "@data/agents";

const layoutProps = {
  title: "About - Arach Tchoupani",
  description:
    "Engineer and founder. Fifteen years building products and the teams behind them, now back in the editor every day, building with my agents.",
};

const experience = resumeData.experience;
const building = projects.filter(p => p.href);
const contacts = accounts.filter(a => a.name !== "Instagram");
const education = resumeData.education[0];
const outside = resumeData.volunteer;
---

<Layout {...layoutProps}>
  <Header activeNav="about" />
  <main id="main-content" class="ab">
    <section class="ab-intro">
      <div class="ch-id">
        <div class="ch-portrait">
          <DitheredPortrait
            client:load
            src="/assets/arach-dither-src.jpg"
            width={240}
            height={240}
            algorithm="atkinson"
            pixelSize={1}
            threshold={128}
            colorLight="#F4F5F7"
            colorDark="#2340F0"
            className="ch-portrait-img"
          />
          <img class="ch-portrait-color" src="/assets/arach.jpg" alt="Arach Tchoupani" width="400" height="400" loading="lazy" />
        </div>
        <p class="ch-fig"><span class="ch-accent">FIG.01</span> Arach Tchoupani<br />Engineer, founder</p>
      </div>

      <h1 class="ab-title">About</h1>
      <p class="ab-lede">
        I'm an engineer and founder. For fifteen years I've built products and
        the teams behind them, at seed-stage startups in New York and Montreal,
        a company I co-founded, and Meta. These days I'm
        <span class="ch-accent">back in the editor</span>, building with my agents.
      </p>

      <dl class="ab-stats">
        <div><dt>Years shipping</dt><dd>15+</dd></div>
        <div><dt>Teams built</dt><dd>0&nbsp;→&nbsp;50+</dd></div>
        <div><dt>Exit</dt><dd>Breathe Life</dd></div>
      </dl>
    </section>

    <section class="ab-section">
      <div class="ch-section-head">
        <h2 class="ch-label"><span class="ch-accent">( 01 )</span> Now</h2>
        <span class="ch-more">2024 — present</span>
      </div>
      <div class="ab-prose">
        <p>
          After a decade of leading engineering orgs, I took a technical
          sabbatical in 2024 to get back to building things myself. Most of my
          time goes into <a href="https://usetalkie.com">Talkie</a>, a native
          voice-to-action app, and the small tools I make along the way. I
          also help friendly startups as a fractional tech lead.
        </p>
        <p>
          What I keep coming back to is AI-native development: what changes
          when one person working with agents has the leverage of a whole team.
          I write about it <a href="/posts/">here</a>.
        </p>
      </div>
    </section>

    <section class="ab-section">
      <div class="ch-section-head">
        <h2 class="ch-label"><span class="ch-accent">( 02 )</span> Path</h2>
        <a href="/resume/" class="ch-more">Full resume →</a>
      </div>
      <ol class="ab-list">
        {experience.map(job => (
          <li class="ab-row">
            <span class="ab-when">{job.dates.replace(" - ", " — ")}</span>
            <div class="ab-what">
              <p class="ab-name">
                {job.companyUrl ? <a href={job.companyUrl}>{job.company}</a> : job.company}
                {job.exit && <span class="ab-tag">{job.exit}</span>}
              </p>
              <p class="ab-role">{job.title}</p>
              <p class="ab-desc">{job.description}</p>
            </div>
            <span class="ab-where">{job.location}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="ab-section">
      <div class="ch-section-head">
        <h2 class="ch-label"><span class="ch-accent">( 03 )</span> Building</h2>
        <a href="https://arach.dev" class="ch-more">arach.dev ↗</a>
      </div>
      <ul class="ab-grid">
        {building.map(p => (
          <li>
            <a href={p.href} class="ab-card">
              <span class="ab-card-name">{p.name} <span aria-hidden="true">↗</span></span>
              <span class="ab-card-desc">{p.desc}</span>
              <span class="ab-card-stack">{p.stack}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="ab-section">
      <div class="ch-section-head">
        <h2 class="ch-label"><span class="ch-accent">( 04 )</span> Outside work</h2>
      </div>
      <ol class="ab-list">
        {outside.map(v => (
          <li class="ab-row">
            <span class="ab-when">{v.dates.replace(" - ", " — ")}</span>
            <div class="ab-what">
              <p class="ab-name">{v.organization}</p>
              <p class="ab-role">{v.role}</p>
              <p class="ab-desc">{v.description}</p>
            </div>
          </li>
        ))}
        {education && (
          <li class="ab-row">
            <span class="ab-when">{education.year}</span>
            <div class="ab-what">
              <p class="ab-name">{education.institution}</p>
              <p class="ab-role">{education.degree}, {education.field}</p>
            </div>
          </li>
        )}
      </ol>
    </section>

    <section class="ab-section ab-contact">
      <div class="ch-section-head">
        <h2 class="ch-label"><span class="ch-accent">( 05 )</span> Say hello</h2>
      </div>
      <ul class="ab-links">
        {contacts.map(a => (
          <li>
            <a href={a.href}>
              <span class="ab-link-name">{a.name}</span>
              <span class="ab-link-handle">{a.handle}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="ch-actions">
        <CalBooking client:load />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .ab {
    --ab-ink: var(--cl-ink, rgb(var(--color-text-base)));
    --ab-muted: var(--cl-muted, rgba(var(--color-text-base), 0.66));
    --ab-faint: var(--cl-faint, rgba(var(--color-text-base), 0.42));
    --ab-rule: var(--cl-rule, rgba(var(--color-text-base), 0.12));
    --ab-accent: var(--cl-accent, rgb(var(--color-accent)));
    --ab-mono: var(--font-mono, ui-monospace, Menlo, monospace);

    width: 100%;
    max-width: calc(var(--cl-wide, 1120px) + 2 * var(--cl-gutter, 24px));
    margin: 0 auto;
    padding: 0 var(--cl-gutter, 24px) 48px;
    color: var(--ab-ink);
  }

  .ab-intro {
    padding: 88px 0 72px;
  }

  .ab-title {
    margin: 0;
    font-size: clamp(40px, 6vw, 76px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.032em;
    color: var(--ab-ink);
  }

  .ab-lede {
    max-width: 600px;
    margin: 28px 0 0;
    font-size: 16px;
    line-height: 1.6;
    letter-spacing: -0.01em;
    color: var(--ab-muted);
  }

  .ab-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 600px;
    margin: 48px 0 0;
    border-top: 1px solid var(--ab-rule);
  }

  .ab-stats > div {
    padding: 16px 16px 0 0;
  }

  .ab-stats > div + div {
    padding-left: 16px;
    border-left: 1px solid var(--ab-rule);
  }

  .ab-stats dt,
  .ab-when,
  .ab-where,
  .ab-tag,
  .ab-card-stack,
  .ab-link-name {
    font-family: var(--ab-mono) !important;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ab-stats dt {
    color: var(--ab-faint);
  }

  .ab-stats dd {
    margin: 6px 0 0;
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--ab-ink);
  }

  .ab-section {
    padding: 0 0 72px !important;
  }

  .ab-prose {
    max-width: 640px;
  }

  .ab-prose p {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ab-ink);
  }

  .ab a {
    color: inherit;
    text-decoration: none;
  }

  .ab-prose a {
    color: var(--ab-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .ab-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ab-row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) auto;
    column-gap: 24px;
    align-items: baseline;
    padding: 20px 0;
  }

  .ab-row + .ab-row {
    border-top: 1px solid var(--ab-rule);
  }

  .ab-when {
    font-variant-numeric: tabular-nums;
    color: var(--ab-faint);
  }

  .ab-where {
    color: var(--ab-faint);
    white-space: nowrap;
  }

  .ab-what p {
    margin: 0;
  }

  .ab-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: var(--ab-ink);
  }

  .ab-name a:hover {
    color: var(--ab-accent);
  }

  .ab-tag {
    font-size: 10px;
    color: var(--ab-accent);
  }

  .ab-role {
    margin-top: 2px !important;
    font-size: 14px;
    color: var(--ab-muted);
  }

  .ab-desc {
    max-width: 640px;
    margin-top: 8px !important;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ab-muted);
  }

  .ab-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ab-rule);
    border-left: 1px solid var(--ab-rule);
  }

  .ab-grid li {
    border-right: 1px solid var(--ab-rule);
    border-bottom: 1px solid var(--ab-rule);
  }

  .ab-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 20px;
    transition: background-color 0.18s ease;
  }

  .ab-card:hover {
    background: rgba(var(--color-accent), 0.05);
  }

  .ab-card-name {
    font-size: 16px;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ab-ink);
  }

  .ab-card:hover .ab-card-name {
    color: var(--ab-accent);
  }

  .ab-card-desc {
    flex: 1;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ab-muted);
  }

  .ab-card-stack {
    font-size: 10px;
    line-height: 1.6;
    color: var(--ab-faint);
  }

  .ab-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ab-links a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 0;
    border-top: 1px solid var(--ab-rule);
    margin-right: 24px;
  }

  .ab-link-name {
    color: var(--ab-faint);
  }

  .ab-link-handle {
    font-size: 15px;
    color: var(--ab-ink);
    transition: color 0.18s ease;
  }

  .ab-links a:hover .ab-link-handle {
    color: var(--ab-accent);
  }

  @media (max-width: 720px) {
    .ab-intro {
      padding: 56px 0 56px;
    }

    .ab-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 6px;
    }

    .ab-where {
      display: none;
    }

    .ab-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .ab-stats dd {
      font-size: 16px;
    }
  }
</style>
