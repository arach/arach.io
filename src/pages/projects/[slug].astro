---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LatticeMark from "@components/LatticeMark.astro";
import { PROJECTS, type Project } from "@data/projects";

export function getStaticPaths() {
  return PROJECTS.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, index: i },
  }));
}

const { project, index } = Astro.props as { project: Project; index: number };
const no = String(index + 1).padStart(2, "0");
const prev = PROJECTS[index - 1];
const next = PROJECTS[index + 1];
const introduced = new Date(project.introduced);
---

<Layout title={`${project.name} | Arach Tchoupani`} description={project.tagline}>
  <Header />
  <main id="main-content" class="pj">
    <section class="pj-intro">
      <p class="pj-kicker">
        <span class="ch-accent">No.{no}</span> Projects, in sequence
        <span class="pj-dot">·</span>
        <time datetime={introduced.toISOString()}>
          {`${introduced.getUTCFullYear()}.${String(introduced.getUTCMonth() + 1).padStart(2, "0")}`}
        </time>
      </p>
      <div class="pj-head">
        <div>
          <h1 class="pj-title">{project.name}</h1>
          <p class="pj-tagline">{project.tagline}</p>
          <div class="pj-actions">
            <a href={project.site} class="ch-btn ch-btn-primary">{project.site.replace("https://", "")} <span aria-hidden="true">↗</span></a>
            <a href={project.repo} class="pj-btn-ghost">GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        {project.slug === "lattices" && <div class="pj-mark"><LatticeMark /></div>}
      </div>
    </section>

    {project.slug === "lattices" && (
      <figure class="pj-figure">
        <video
          src="/assets/projects/lattices-demo.mp4"
          poster="/assets/projects/lattices-demo-poster.jpg"
          width="840"
          height="472"
          autoplay
          muted
          loop
          playsinline
        />
        <figcaption><span class="ch-accent">FIG.01</span> Agent session, gesture preview and synced workspace state</figcaption>
      </figure>
    )}

    <section class="pj-section">
      <div class="ch-section-head">
        <h2 class="ch-label"><span class="ch-accent">( 01 )</span> Why</h2>
        <span class="ch-more">{project.kind}</span>
      </div>
      <div class="pj-prose">
        {project.intro.map(p => <p>{p}</p>)}
      </div>
    </section>

    <section class="pj-section">
      <div class="ch-section-head">
        <h2 class="ch-label"><span class="ch-accent">( 02 )</span> What it does</h2>
      </div>
      <ul class="pj-features">
        {project.features.map((f, i) => (
          <li>
            <span class="pj-feature-index">{String(i + 1).padStart(2, "0")}</span>
            <span class="pj-feature-name">{f.name}</span>
            <span class="pj-feature-desc">{f.desc}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="pj-section">
      <div class="ch-section-head">
        <h2 class="ch-label"><span class="ch-accent">( 03 )</span> Try it</h2>
        <a href={`${project.site}/docs/quickstart`} class="ch-more">Quickstart ↗</a>
      </div>
      <pre class="pj-code"><code><span class="pj-prompt">$</span> {project.install}</code></pre>
      <p class="pj-stack">{project.stack}</p>
    </section>

    <nav class="pj-series" aria-label="Project series">
      {prev ? (
        <a href={`/projects/${prev.slug}/`}><span>← No.{String(index).padStart(2, "0")}</span>{prev.name}</a>
      ) : <span />}
      {next ? (
        <a href={`/projects/${next.slug}/`} class="pj-next"><span>No.{String(index + 2).padStart(2, "0")} →</span>{next.name}</a>
      ) : (
        <p class="pj-next pj-soon"><span>No.{String(index + 2).padStart(2, "0")}</span>Coming next</p>
      )}
    </nav>
  </main>
  <Footer />
</Layout>

<style>
  .pj {
    --pj-ink: var(--cl-ink, rgb(var(--color-text-base)));
    --pj-muted: var(--cl-muted, rgba(var(--color-text-base), 0.66));
    --pj-faint: var(--cl-faint, rgba(var(--color-text-base), 0.42));
    --pj-rule: var(--cl-rule, rgba(var(--color-text-base), 0.12));
    --pj-accent: var(--cl-accent, rgb(var(--color-accent)));
    --pj-mono: var(--font-mono, ui-monospace, Menlo, monospace);

    width: 100%;
    max-width: calc(var(--cl-wide, 1120px) + 2 * var(--cl-gutter, 24px));
    margin: 0 auto;
    padding: 0 var(--cl-gutter, 24px) 48px;
    color: var(--pj-ink);
  }

  .pj section {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .pj-intro {
    padding: 88px 0 56px;
  }

  .pj-kicker,
  .pj-stack,
  .pj-feature-index,
  .pj-series span,
  .pj figcaption {
    font-family: var(--pj-mono) !important;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pj-kicker {
    margin: 0 0 28px;
    color: var(--pj-muted);
  }

  .pj-dot {
    margin: 0 8px;
    color: var(--pj-faint);
  }

  .pj-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 168px;
    gap: 48px;
    align-items: end;
  }

  .pj-title {
    margin: 0;
    font-size: clamp(44px, 7vw, 88px);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.032em;
    color: var(--pj-ink);
  }

  .pj-tagline {
    max-width: 560px;
    margin: 24px 0 0;
    font-size: 16px;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--pj-muted);
  }

  .pj-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .pj-actions .ch-btn,
  .pj-btn-ghost {
    height: 36px;
    border-radius: 999px !important;
    font-size: 13px;
  }

  .pj-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    border: 1px solid var(--cl-rule-strong, var(--pj-rule));
    border-radius: 999px;
    color: var(--pj-ink);
    text-decoration: none;
    transition: border-color 0.18s ease, color 0.18s ease;
  }

  .pj-btn-ghost:hover {
    border-color: var(--pj-accent);
    color: var(--pj-accent);
  }

  .pj-mark {
    color: var(--pj-ink);
  }

  .pj-figure {
    margin: 0 0 80px;
  }

  .pj-figure video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--pj-rule);
  }

  .pj figcaption {
    margin-top: 12px;
    color: var(--pj-muted);
  }

  .pj-section {
    padding-bottom: 72px !important;
  }

  .pj-prose {
    max-width: 660px;
  }

  .pj-prose p {
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--pj-ink);
  }

  .pj-features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--pj-rule);
    border-left: 1px solid var(--pj-rule);
  }

  .pj-features li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border-right: 1px solid var(--pj-rule);
    border-bottom: 1px solid var(--pj-rule);
  }

  .pj-feature-index {
    color: var(--pj-accent);
  }

  .pj-feature-name {
    font-size: 16px;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--pj-ink);
  }

  .pj-feature-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--pj-muted);
  }

  .pj-code {
    margin: 0;
    padding: 18px 20px;
    overflow-x: auto;
    border: 1px solid var(--pj-rule);
    background: transparent;
    font-family: var(--pj-mono) !important;
    font-size: 14px;
    font-weight: 300;
    color: var(--pj-ink);
  }

  .pj-prompt {
    margin-right: 6px;
    color: var(--pj-accent);
    user-select: none;
  }

  .pj-stack {
    margin: 16px 0 0;
    color: var(--pj-faint);
  }

  .pj-series {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--cl-rule-strong, var(--pj-rule));
  }

  .pj-series a,
  .pj-series p {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: -0.025em;
    color: var(--pj-ink);
    text-decoration: none;
  }

  .pj-series span {
    color: var(--pj-faint);
  }

  .pj-series a:hover {
    color: var(--pj-accent);
  }

  .pj-next {
    margin-left: auto !important;
    text-align: right;
  }

  .pj-soon {
    color: var(--pj-faint) !important;
  }

  @media (max-width: 720px) {
    .pj-intro {
      padding: 56px 0 40px;
    }

    .pj-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .pj-mark {
      display: none;
    }

    .pj-features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
