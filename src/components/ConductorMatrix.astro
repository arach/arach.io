---
/**
 * The Conductor alternatives as one quick visual: GitHub stars, where the
 * agents run (local, cloud) and which features each tool's own pages back.
 * Majors come first, then up-and-comers, under a slim divider row, so both
 * groups share one set of columns.
 */
import { NEEDS, TIER_LABEL, TOOLS, formatStars, type Need, type Tier } from "./conductorTools";

const COL: Record<Need, string> = {
  remote: "Remote",
  worktrees: "Worktrees",
  review: "Review",
  phone: "Phone",
  openSource: "Open source",
  free: "Free",
  conductorImport: "Conductor import",
};

const TIERS: Tier[] = ["major", "rising"];
const byStars = (tier: Tier) =>
  TOOLS.filter(t => t.tier === tier).sort((a, b) => (b.repo?.stars ?? -1) - (a.repo?.stars ?? -1));
const SPAN = 3 + NEEDS.length;
---

<div class="conductor-matrix not-prose my-6 overflow-x-auto">
  <table>
    <thead>
      <tr>
        <th scope="col" class="tool">Tool</th>
        <th scope="col" class="group-start stars">Stars</th>
        <th scope="col" class="group-start">Local</th>
        <th scope="col">Cloud</th>
        {NEEDS.map((n, i) => (
          <th scope="col" class={i === 0 ? "group-start" : undefined} title={n.label}>{COL[n.id]}</th>
        ))}
      </tr>
    </thead>
    {TIERS.map(tier => (
      <tbody>
        <tr class="tier">
          <th scope="colgroup" class="tool">{TIER_LABEL[tier]}</th>
          <td colspan={SPAN} />
        </tr>
        {byStars(tier).map(t => (
          <tr>
            <th scope="row" class="tool">
              <a href={t.url} target="_blank" rel="noopener">{t.name}</a>
            </th>
            <td class="group-start stars">
              {t.repo ? (
                <a href={`https://github.com/${t.repo.slug}`} target="_blank" rel="noopener" title={`${t.repo.stars.toLocaleString("en-US")} stars`}>
                  {formatStars(t.repo.stars)}
                </a>
              ) : (
                <span class="none" title="No public repository" aria-label="No public repository">–</span>
              )}
            </td>
            {[t.runs.own, t.runs.maker].map((on, i) => (
              <td class={i === 0 ? "group-start" : undefined}>
                {on ? <span class="dot" aria-label="Yes" /> : <span class="sr-only">No</span>}
              </td>
            ))}
            {NEEDS.map((n, i) => (
              <td class={i === 0 ? "group-start" : undefined}>
                {t.has.includes(n.id) ? <span class="dot" aria-label="Yes" /> : <span class="sr-only">Not stated</span>}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    ))}
  </table>
</div>

<style>
  .conductor-matrix {
    position: relative;
    width: 0;
    min-width: 100%;
  }
  .conductor-matrix table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .conductor-matrix th,
  .conductor-matrix td {
    padding: 0.55rem 0.5rem;
    border-bottom: 1px solid rgb(var(--color-border));
    text-align: center;
    vertical-align: middle;
  }
  .conductor-matrix thead th {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
    line-height: 1.2;
    vertical-align: bottom;
  }
  .conductor-matrix .tool {
    position: sticky;
    left: 0;
    z-index: 1;
    text-align: left;
    font-weight: 500;
    white-space: nowrap;
    background: rgb(var(--color-fill));
  }
  .conductor-matrix thead .tool {
    font-weight: 400;
  }
  .conductor-matrix .group-start {
    border-left: 1px solid rgb(var(--color-border));
  }
  .conductor-matrix .stars {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .conductor-matrix a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .conductor-matrix .stars a {
    text-decoration: none;
    opacity: 0.8;
  }
  .conductor-matrix .none {
    opacity: 0.5;
  }
  .conductor-matrix tr.tier th,
  .conductor-matrix tr.tier td {
    padding-top: 1.1rem;
    padding-bottom: 0.3rem;
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
    border-left: 0;
  }
  .conductor-matrix tbody:first-of-type tr.tier th,
  .conductor-matrix tbody:first-of-type tr.tier td {
    padding-top: 0.6rem;
  }
  .conductor-matrix .dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: rgb(var(--color-text-base));
  }
</style>
